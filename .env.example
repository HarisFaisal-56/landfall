# Frontend (all optional; defaults are Agora's published Monad testnet addresses)
# VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# VITE_AUSD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
# VITE_AUSD_FAUCET=0xd236c18D274E54FAccC3dd9DDA4b27965a73ee6C
# VITE_AGORA_PAIR=0x1Aa8958Aa34cEC8096EF4381cb335effe977b0ae
# VITE_SESSION_MINUTES=15
# VITE_SESSION_LIMIT_USD=100

# Gas top-up for new accounts (api/drip.js) and the fund script.
# Set FUNDER_PRIVATE_KEY in Vercel's environment variables, or in .env.local for local dev.
# Testnet-only key, never one that holds real funds.
# FUNDER_PRIVATE_KEY=
# DRIP_MON=0.05
